@model AssignmentTest1.Models.Entities.Facility
@{
    var isEdit = Model.FacilityId > 0;
    ViewData["Title"] = isEdit ? "Edit Facility" : "Add Facility";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .facility-form-card { max-width:850px; margin:2rem auto; background:#fff; border:1px solid #E5E7EB; border-radius:18px; padding:2rem; box-shadow:0 8px 25px rgba(0,0,0,.05); }
    .facility-form-card h1 { font-weight:800; color:#1A1A2E; }
    .form-label { font-weight:600; color:#374151; }
    .form-control,.form-select { border-radius:10px; padding:.7rem .85rem; }
</style>

<div class="facility-form-card">
    <a asp-action="Index" class="text-decoration-none"><i class="fas fa-arrow-left me-1"></i>Back to Facilities</a>
    <div class="mt-3 mb-4">
        <h1>@(isEdit ? "Edit Facility" : "Add New Facility")</h1>
        <p class="text-muted mb-0">Enter the details for a facility in this clubhouse.</p>
    </div>

    <form asp-action="@(isEdit ? "Edit" : "Create")" asp-route-id="@(isEdit ? Model.FacilityId : null)" method="post">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
        @if (isEdit)
        {
            <input type="hidden" asp-for="FacilityId" />
        }

        <div class="row g-3">
            <div class="col-md-6">
                <label asp-for="Name" class="form-label"></label>
                <input asp-for="Name" class="form-control" placeholder="e.g. Badminton Court 1" />
                <span asp-validation-for="Name" class="text-danger small"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="Category" class="form-label"></label>
                <select asp-for="Category" class="form-select">
                    <option value="Sports">Sports</option>
                    <option value="Swimming">Swimming</option>
                    <option value="Events">Events</option>
                    <option value="Fitness">Fitness</option>
                    <option value="Other">Other</option>
                </select>
                <span asp-validation-for="Category" class="text-danger small"></span>
            </div>
            <div class="col-12">
                <label asp-for="Description" class="form-label"></label>
                <textarea asp-for="Description" class="form-control" rows="3" placeholder="Describe this facility..."></textarea>
                <span asp-validation-for="Description" class="text-danger small"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="Capacity" class="form-label"></label>
                <input asp-for="Capacity" class="form-control" type="number" min="1" />
                <span asp-validation-for="Capacity" class="text-danger small"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="HourlyRate" class="form-label"></label>
                <div class="input-group">
                    <span class="input-group-text">RM</span>
                    <input asp-for="HourlyRate" class="form-control" type="number" min="0" step="0.01" />
                </div>
                <span asp-validation-for="HourlyRate" class="text-danger small"></span>
            </div>
            @if (isEdit)
            {
                <div class="col-12">
                    <div class="form-check form-switch">
                        <input asp-for="IsActive" class="form-check-input" />
                        <label asp-for="IsActive" class="form-check-label">Facility is active and available for booking</label>
                    </div>
                </div>
            }
        </div>

        <div class="d-flex justify-content-end gap-2 mt-4">
            <a asp-action="Index" class="btn btn-light px-4">Cancel</a>
            <button type="submit" class="btn btn-primary px-4">
                <i class="fas fa-save me-2"></i>@(isEdit ? "Save Changes" : "Add Facility")
            </button>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
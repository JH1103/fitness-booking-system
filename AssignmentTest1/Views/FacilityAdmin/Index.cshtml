@model IEnumerable<AssignmentTest1.Models.Entities.Facility>
@{
    ViewData["Title"] = "Manage Facilities";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .facility-admin-header { display:flex; justify-content:space-between; align-items:center; gap:1rem; flex-wrap:wrap; margin:1.5rem 0; }
    .facility-admin-header h1 { font-weight:800; color:#1A1A2E; margin:0; }
    .facility-admin-header p { color:#6B7280; margin:.35rem 0 0; }
    .facility-table-card { background:#fff; border:1px solid #E5E7EB; border-radius:16px; padding:1.25rem; box-shadow:0 5px 20px rgba(0,0,0,.04); }
    .facility-table th { color:#6B7280; font-size:.78rem; text-transform:uppercase; letter-spacing:.04em; white-space:nowrap; }
    .facility-table td { vertical-align:middle; }
    .facility-name { font-weight:700; color:#1F2937; }
    .category-pill { display:inline-block; background:#EEF1FF; color:#3A56D4; border-radius:20px; padding:.3rem .65rem; font-size:.78rem; font-weight:600; }
    .status-pill { display:inline-block; border-radius:20px; padding:.3rem .65rem; font-size:.78rem; font-weight:700; }
    .status-active { background:#DCFCE7; color:#166534; }
    .status-inactive { background:#F3F4F6; color:#6B7280; }
    @@media(max-width:768px) { .facility-table-card { padding:.75rem; } }
</style>

<div class="container-fluid">
    <div class="facility-admin-header">
        <div>
            <h1><i class="fas fa-building me-2 text-primary"></i>Manage Facilities</h1>
            <p>Add and maintain the bookable facilities in your clubhouse.</p>
        </div>
        <a asp-action="Create" class="btn btn-primary rounded-pill px-4">
            <i class="fas fa-plus me-2"></i>Add New Facility
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="facility-table-card">
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
            <div>
                <h5 class="fw-bold mb-1">Clubhouse Facilities</h5>
                <span class="text-muted small">@Model.Count() facility record(s)</span>
            </div>
            <span class="text-muted small"><i class="fas fa-location-dot me-1"></i>One clubhouse location</span>
        </div>

        <div class="table-responsive">
            <table class="table facility-table align-middle">
                <thead>
                    <tr>
                        <th>Facility</th>
                        <th>Category</th>
                        <th>Capacity</th>
                        <th>Hourly Price</th>
                        <th>Status</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                @if (!Model.Any())
                {
                    <tr><td colspan="6" class="text-center py-5 text-muted">
                        <i class="fas fa-building-circle-exclamation fs-2 d-block mb-2"></i>
                        No facilities added yet. Select "Add New Facility" to create your first one.
                    </td></tr>
                }
                else
                {
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>
                                <div class="facility-name">@item.Name</div>
                                <div class="small text-muted">@(string.IsNullOrWhiteSpace(item.Description) ? "No description" : item.Description)</div>
                            </td>
                            <td><span class="category-pill">@item.Category</span></td>
                            <td>@item.Capacity people</td>
                            <td>RM @item.HourlyRate.ToString("0.00")</td>
                            <td>
                                <span class="status-pill @(item.IsActive ? "status-active" : "status-inactive")">
                                    @(item.IsActive ? "Active" : "Inactive")
                                </span>
                            </td>
                            <td class="text-end">
                                <a asp-action="Edit" asp-route-id="@item.FacilityId" class="btn btn-sm btn-outline-primary">
                                    <i class="fas fa-pen me-1"></i>Edit
                                </a>
                                <form asp-action="ToggleStatus" asp-route-id="@item.FacilityId" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm @(item.IsActive ? "btn-outline-danger" : "btn-outline-success")"
                                            onclick="return confirm('Are you sure you want to @(item.IsActive ? "deactivate" : "activate") this facility?');">
                                        <i class="fas @(item.IsActive ? "fa-ban" : "fa-check") me-1"></i>@(item.IsActive ? "Deactivate" : "Activate")
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                }
                </tbody>
            </table>
        </div>
    </div>
</div>
@{
    ViewData["Title"] = "Welcome to FitBook Clubhouse";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .welcome-wrap { max-width: 1050px; margin: 2rem auto; }
    .welcome-hero {
        padding: 3rem 1.5rem;
        text-align: center;
        border-radius: 22px;
        background: linear-gradient(135deg, #EEF1FF 0%, #FFFFFF 100%);
        margin-bottom: 2rem;
    }
    .welcome-hero .hero-icon { font-size: 3.5rem; color: #4F6EF7; margin-bottom: 1rem; }
    .welcome-hero h1 { color: #1A1A2E; font-weight: 800; }
    .welcome-hero h1 span { color: #4F6EF7; }
    .welcome-hero p { color: #6B7280; max-width: 620px; margin: .75rem auto 0; }
    .access-card {
        height: 100%; background: #fff; border: 1px solid #E5E7EB;
        border-radius: 16px; padding: 2rem 1.5rem; text-align: center;
        transition: all .25s ease;
    }
    .access-card:hover { transform: translateY(-5px); box-shadow: 0 12px 30px rgba(0,0,0,.08); }
    .access-icon {
        width: 66px; height: 66px; border-radius: 18px; margin: 0 auto 1.2rem;
        display: grid; place-items: center; background: #EEF1FF; color: #4F6EF7; font-size: 1.7rem;
    }
    .access-card h4 { color: #1A1A2E; font-weight: 700; }
    .access-card p { color: #6B7280; min-height: 48px; }
    .access-card .btn { border-radius: 50px; padding: .7rem 1.5rem; font-weight: 600; }
    .welcome-note { color: #6B7280; font-size: .9rem; text-align: center; margin-top: 1.5rem; }
</style>

<div class="container welcome-wrap">
    <section class="welcome-hero fade-in-up">
        <div class="hero-icon"><i class="fas fa-building"></i></div>
        <h1>Welcome to <span>FitBook Clubhouse</span></h1>
        <p>Enjoy convenient access to clubhouse facilities and fitness activities. Choose how you would like to continue.</p>
    </section>

    <div class="row g-4">
        <div class="col-md-4">
            <div class="access-card">
                <div class="access-icon"><i class="fas fa-user-check"></i></div>
                <h4>Existing Member</h4>
                <p>Sign in to your member account to manage your bookings and membership.</p>
                <a asp-controller="Account" asp-action="Login" class="btn btn-primary w-100">
                    <i class="fas fa-sign-in-alt me-2"></i>Member Login
                </a>
            </div>
        </div>

        <div class="col-md-4">
            <div class="access-card">
                <div class="access-icon"><i class="fas fa-user-plus"></i></div>
                <h4>New Member</h4>
                <p>Create an account to enjoy member services and manage your activities.</p>
                <a asp-controller="Account" asp-action="Register" class="btn btn-outline-primary w-100">
                    <i class="fas fa-user-plus me-2"></i>Register Now
                </a>
            </div>
        </div>

        <div class="col-md-4">
            <div class="access-card">
                <div class="access-icon"><i class="fas fa-walking"></i></div>
                <h4>Visitor</h4>
                <p>Continue without an account to explore facilities and make an online visitor booking.</p>
                <a asp-controller="Facilities" asp-action="Index" class="btn btn-outline-dark w-100">
                    <i class="fas fa-arrow-right me-2"></i>Continue as Visitor
                </a>
            </div>
        </div>
    </div>

    <p class="welcome-note">
        Walk-in visitors may also request booking assistance from the clubhouse receptionist.
    </p>
</div>
